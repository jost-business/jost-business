{
  "name": "header-element",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/header-element/src",
  "tags": ["type:element", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/components/header",
        "browser": "apps/header-element/src/main.ts",
        "index": "apps/header-element/src/index.html",
        "tsConfig": "apps/header-element/tsconfig.app.json",
        "styles": ["libs/shared/src/styles/index.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/src/styles"]
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "none"
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "typecheck": {
      "options": {
        "commands": ["ngc -p apps/header-element/tsconfig.app.json --noEmit"],
        "parallel": false
      }
    }
  }
}
