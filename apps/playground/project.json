{
  "name": "playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/playground",
          "browser": ""
        },
        "index": "apps/playground/src/index.development.html",
        "browser": "apps/playground/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/playground/tsconfig.app.json",
        "assets": [
          "apps/playground/src/favicon.ico",
          "apps/playground/src/assets",
          {
            "glob": "**/*",
            "input": "apps/playground/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared-assets/src/images",
            "output": "/assets/images"
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/src/styles"]
        },
        "styles": [
          "libs/shared/src/styles/index.scss",
          "apps/playground/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "development": {
          "index": "apps/playground/src/index.development.html",
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false
        },
        "production": {
          "index": "apps/playground/src/index.production.html",
          "serviceWorker": "apps/playground/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "optimization": true,
          "sourceMap": false,
          "extractLicenses": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "playground:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "playground:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
