{
  "name": "pwa-countdown",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/pwa-countdown/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/pwa-countdown",
        "browser": "apps/pwa-countdown/src/main.ts",
        "tsConfig": "apps/pwa-countdown/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/pwa-countdown/public"
          },
          {
            "glob": "**/*",
            "input": "apps/pwa-countdown/src/assets",
            "output": "assets"
          },
          {
            "glob": "*.{jpg,jpeg,png,webp,svg,gif}",
            "input": "libs/shared-assets/src/images",
            "output": "assets/images"
          }
        ],
        "styles": ["apps/pwa-countdown/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "pwa-countdown:build:production"
        },
        "development": {
          "buildTarget": "pwa-countdown:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "pwa-countdown:build",
        "staticFilePath": "dist/apps/pwa-countdown/browser",
        "spa": true
      }
    }
  }
}
