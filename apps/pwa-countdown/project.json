{
  "name": "pwa-countdown",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/pwa-countdown/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/pwa-countdown",
        "browser": "apps/pwa-countdown/src/main.ts",
        "tsConfig": "apps/pwa-countdown/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/pwa-countdown/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared-assets/src/images",
            "output": "assets/images",
            "ignore": ["trips/**"]
          }
        ],
        "styles": ["apps/pwa-countdown/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/countdown/"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "configurations": {
        "production": {
          "buildTarget": "pwa-countdown:build:production"
        },
        "development": {
          "buildTarget": "pwa-countdown:build:development"
        }
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/pwa-countdown"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/pwa-countdown"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "pwa-countdown:build",
        "staticFilePath": "dist/apps/pwa-countdown/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
