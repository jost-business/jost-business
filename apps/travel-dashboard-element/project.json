{
  "name": "travel-dashboard-element",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/travel-dashboard-element/src",
  "tags": ["type:element", "scope:travel"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/components/travel-dashboard",
        "browser": "apps/travel-dashboard-element/src/main.ts",
        "index": "apps/travel-dashboard-element/src/index.html",
        "tsConfig": "apps/travel-dashboard-element/tsconfig.app.json",
        "styles": ["libs/shared/src/styles/index.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/src/styles"]
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "none"
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
