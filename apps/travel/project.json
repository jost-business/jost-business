{
  "name": "travel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/travel/src",
  "projectType": "application",
  "prefix": "app",
  "tags": [
    "type:app",
    "scope:travel"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/travel",
          "browser": ""
        },
        "index": "apps/travel/src/index.development.html",
        "browser": "apps/travel/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/travel/tsconfig.app.json",
        "assets": [
          {
            "glob": "*",
            "input": "libs/shared-assets/src/favicon",
            "output": "/"
          },
          "apps/travel/src/assets",
          {
            "glob": "**/*",
            "input": "libs/shared-assets/src/images",
            "output": "/assets/images"
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/shared/src/styles"
          ]
        },
        "styles": [
          "libs/shared/src/styles/index.scss",
          "apps/travel/src/styles.scss",
          "node_modules/leaflet/dist/leaflet.css"
        ],
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true
      },
      "configurations": {
        "development": {
          "index": "apps/travel/src/index.development.html"
        },
        "production": {
          "index": "apps/travel/src/index.production.html",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": true,
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "travel:build:development",
        "proxyConfig": "proxy.conf.json",
        "port": 4310
      },
      "configurations": {
        "production": {
          "buildTarget": "travel:build:production"
        }
      },
      "continuous": true
    },
    "typecheck": {
      "options": {
        "commands": [
          "ngc -p apps/travel/tsconfig.app.json --noEmit",
          "tsc -p apps/travel/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "browsers": [
          "ChromiumHeadless"
        ]
      }
    }
  }
}
