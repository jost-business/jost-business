{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "prefix": "lib",
  "tags": ["type:core", "scope:shared"],
  "targets": {
    "test": {
      "outputs": ["{workspaceRoot}/coverage/libs/shared"],
      "options": {
        "coverage.reportsDirectory": "../../coverage/libs/shared"
      }
    },
    "typecheck": {
      "options": {
        "commands": [
          "ngc -p libs/shared/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
