{
  "name": "ui-countdown",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/countdown/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:ui", "scope:shared"],
  "targets": {
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/ui/countdown"
      ],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/ui/countdown"
      }
    },
    "typecheck": {
      "options": {
        "commands": [
          "ngc -p libs/ui/countdown/tsconfig.lib.json --noEmit",
          "tsc -p libs/ui/countdown/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
